function req(url:string,role:string|null,method='GET',body?:unknown){return new NextRequest(`http://127.0.0.1${url}`,{method,headers:{...(role?{authorization:`Bearer ${identities[role].token}`}:{ }), 'content-type':'application/json'},...(body===undefined?{}:{body:JSON.stringify(body)})});}
async function call(p:string,method:string,role:string|null='client',body?:unknown,context=ctx('LEGACY-A'),query=''){
