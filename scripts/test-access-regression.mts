await test('A1 exhaustive authenticated employee-handler boundary, including _req read-only methods',async()=>{let checked=0;const failures:any[]=[];const root=path.join(sourceRoot,'src/app/api');const routes=fs.readdirSync(root,{recursive:true}).filter((p)=>typeof p==='string'&&p.endsWith('route.ts')) as string[];for(const relative of routes){const source=fs.readFileSync(path.join(root,relative),'utf8');const routePath=relative.replace(/\/route.ts$/,'');const functions=source.split(/(?=export async function (?:GET|POST|PATCH|PUT|DELETE)\()/);for(const fn of functions){const method=/^export async function (\w+)/.exec(fn)?.[1];if(!method||!fn.includes('await verifyAuth(')||customerMethods.has(`${routePath}:${method}`))continue;const before=total();try{const r=await call(routePath,method,'client',['GET','DELETE'].includes(method)?undefined:{},ctx('1','1'));if(r.status!==403||total()!==before)failures.push({routePath,method,status:r.status,writes:total()-before})}catch(e){failures.push({routePath,method,error:String(e)})}checked++;}}
