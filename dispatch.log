    authVersion: user.auth_version,
    passwordChangeRequired: user.must_change_password === 1,
  } as unknown as Record<string, unknown>)
    .setProtectedHeader({ alg: "HS256" })
    .setIssuedAt()
    .setExpirationTime(expiresIn)
    .sign(secret);
}

