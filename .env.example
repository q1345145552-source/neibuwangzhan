# 复制为 .env（或 .env.local）并填入实际值。切勿把真实密钥提交进 git。

# ── 必填：登录令牌签名密钥 ──
# 生产环境未设置会直接拒绝启动。生成方式：openssl rand -hex 32
JWT_SECRET=

# ── 必填（如果用定时任务）：cron 内部调用密钥 ──
# 供 scripts/vat-auto-generate.sh、scripts/wht-auto-generate.sh 调用生成接口时使用。
# 未设置时，接口的 cron 分支直接不可用（正常登录调用不受影响）。
# 生成方式：openssl rand -hex 32
CRON_SECRET=

# ── 可选：客户端跨域来源白名单（逗号分隔）──
# 默认 http://localhost:3000,http://localhost:3001
CORS_ORIGINS=
